# SaveMyWay Environment Variables
# (All keys are optional; the app has built-in free market data fallbacks)

# NGX (Nigerian Stock Exchange) live quote provider
VITE_NGX_PULSE_API_KEY=

# US Stocks live quote provider (Yahoo Finance browser fallback may be blocked by CORS)
# VITE_ values are public in the client build; use a server proxy for private credentials.
VITE_FINNHUB_API_KEY=
